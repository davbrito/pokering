{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "test/**",
      "!src/routeTree.gen.ts",
      "!src/api/pokeapi",
      "!src/i18n/paraglide",
      ".vscode/*",
      "index.html",
      "vite.config.ts",
      "vitest.config.ts",
      "messages/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": { "noExplicitAny": "off" },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "info",
          "fix": "safe"
        }
      },
      "a11y": {
        "noAutofocus": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "lineWidth": 120
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "preset": "recommended",
        "organizeImports": "on"
      }
    }
  },
  "tailwind": { "mergeFunctions": ["clsx", "cn"] }
}
